        I.dPbcCnDedcn.upload(dEdcn, nat, stream);
        I.dPbcCnTrans.upload(trans, 3 * ntrans, stream);
        I.dPbcCnFix.ensure(3 * nat + 9);
        if (hipMemsetAsync(I.dPbcCnFix.ptr, 0, sizeof(double) * (3 * nat + 9), stream) != hipSuccess) return false;
        double* gfix = I.dPbcCnFix.ptr;
        double* vfix = gfix + 3 * nat;
        const dim3 blk(16, 16);   // 256 threads: the block tree of the virial assumes a power of two
        const dim3 grd((nat + 15) / 16, (nat + 15) / 16);
        if (want_virial)
            pbc_dev::k_cnchain_pbc<true><<<grd, blk, 0, stream>>>(nat, I.dPbcXyz.ptr, I.dPbcCnRcov.ptr, I.dPbcCnDedcn.ptr,
                cell_L[0], cell_L[1], cell_L[2], ntrans, I.dPbcCnTrans.ptr, cut2, gfn1 ? 1 : 0, gfix, vfix);
        else
            pbc_dev::k_cnchain_pbc<false><<<grd, blk, 0, stream>>>(nat, I.dPbcXyz.ptr, I.dPbcCnRcov.ptr, I.dPbcCnDedcn.ptr,
                cell_L[0], cell_L[1], cell_L[2], ntrans, I.dPbcCnTrans.ptr, cut2, gfn1 ? 1 : 0, gfix, vfix);
        if (hipGetLastError() != hipSuccess) return false;
        const int nfix = 3 * nat + 9;
        pbc_dev::k_pfix_to_double<<<(nfix + 255) / 256, 256, 0, stream>>>(nfix, gfix);
        if (hipGetLastError() != hipSuccess) return false;
        I.dPbcCnFix.download(grad_out, 3 * nat, stream);
        if (want_virial && hipMemcpyAsync(vir9_out, vfix, sizeof(double) * 9, hipMemcpyDeviceToHost, stream) != hipSuccess)
            return false;
    } catch (...) {
        return false;
    }
    if (hipStreamSynchronize(stream) != hipSuccess) return false;
    int fix_bad = 0;   // a non-finite or out-of-range contribution: fail (the host loop runs), reset the flag
    if (hipMemcpyFromSymbol(&fix_bad, HIP_SYMBOL(pbc_dev::g_pfix_bad), sizeof(int)) != hipSuccess) return false;
    if (fix_bad) {
        const int zero = 0;
        (void)hipMemcpyToSymbol(HIP_SYMBOL(pbc_dev::g_pfix_bad), &zero, sizeof(int));
        return false;
    }
    return true;
}

