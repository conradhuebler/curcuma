// Claude Generated (Nov 23, 2026): exact token of CURCUMA_PBC_GPU_HOST (comma/space/colon/semicolon separated, "all"
// matches every token); the host side uses the same rule (pbcGpuStageOnHost in xtb_periodic.cpp).
static bool hipPbcHostTokenSet(const char* token)
{
    const char* e = std::getenv("CURCUMA_PBC_GPU_HOST");
    if (!e || !*e) return false;
    const std::string v(e), t(token);
    size_t pos = 0;
    while (pos <= v.size()) {
        const size_t end = v.find_first_of(", :;", pos);
        const std::string item = v.substr(pos, end == std::string::npos ? std::string::npos : end - pos);
        if (item == "all" || item == t) return true;
        if (end == std::string::npos) break;
        pos = end + 1;
    }
    return false;
}

// ---- cuda/xtb_gpu_context.cu lines 8908-9245 ----
bool XtbHipContext::multipoleMatricesPeriodic(int nat, const double* xyz_bohr, const double* mrad, const double* cell_L,
                                              int ndtrans, const double* dtrans, int nrtrans, const double* rtrans,
                                              const double* kexp, double alpha, double dmp3, double dmp5, double sd_f,
                                              double sq_f, double fac, double* const* out18)
{
    Impl& M = *m_impl;
    PbcState& I = M.pbc;
    M.pbc.mp_pbc_resident = false;
    if (!ok() || nat <= 0 || ndtrans <= 0 || nrtrans < 0 || !xyz_bohr || !mrad || !cell_L || !dtrans
        || (nrtrans > 0 && (!rtrans || !kexp)))
        return false;
    const size_t n2 = static_cast<size_t>(nat) * nat;
    if (18 * n2 > static_cast<size_t>(INT_MAX)) return false;
    hipStream_t stream = M.stream;
    // ROCm A3: the resident copy of CUDA R2/R4 (dMpAmat* for beginPotentialPeriodic) is not ported; the matrices
    // always go to the host (out18 == nullptr, the device-only request of R4, is refused).
    if (!out18) return false;
    try {
        I.dPbcXyz.upload(xyz_bohr, 3 * nat, stream);
        I.dPbcMrad.upload(mrad, nat, stream);
        I.dPbcDtrans.upload(dtrans, 3 * ndtrans, stream);
        if (nrtrans > 0) {
            I.dPbcRtrans.upload(rtrans, 3 * nrtrans, stream);
            I.dPbcKexp.upload(kexp, nrtrans, stream);
        }
        I.dPbcAmat.ensure(static_cast<int>(18 * n2));
        const dim3 blk(16, 16);
        const dim3 grd((nat + 15) / 16, (nat + 15) / 16);
        pbc_dev::k_mp_amat_pbc<<<grd, blk, 0, stream>>>(nat, I.dPbcXyz.ptr, I.dPbcMrad.ptr, cell_L[0], cell_L[1], cell_L[2],
                                               ndtrans, I.dPbcDtrans.ptr, nrtrans,
                                               nrtrans > 0 ? I.dPbcRtrans.ptr : nullptr,
                                               nrtrans > 0 ? I.dPbcKexp.ptr : nullptr, alpha, dmp3, dmp5, sd_f, sq_f,
                                               fac, I.dPbcAmat.ptr);
        if (hipGetLastError() != hipSuccess) return false;
        if (out18)
            for (int b = 0; b < 18; ++b)
                if (hipMemcpyAsync(out18[b], I.dPbcAmat.ptr + b * n2, n2 * sizeof(double), hipMemcpyDeviceToHost,
                                    stream) != hipSuccess)
                    return false;
        if (hipStreamSynchronize(stream) != hipSuccess) return false;
        I.mp_pbc_resident = false;
        I.mp_pbc_nat = 0;
    } catch (...) {
        return false;
    }
    I.dPbcAmat.free();
    return true;
}

// Claude Generated (Nov 2026, WP-PERIODIC-XTB G2): periodic shell gamma (kernels k_ewald_phase, k_ewald_finish,
// k_gamma_pbc, reciprocal rank update by cublasDsyrk). Any failure returns false and the host loop runs.
bool XtbHipContext::ewaldGammaPeriodic(int nat, const double* xyz_bohr, const double* cell_L, double alpha,
                                       double volume, double r_cut, int nk, const double* ktab, int nsh,
                                       const int* sh2at, const double* hardness, bool harmonic, double gexp, int nko,
                                       const double* ko_trans, double ko_cut, double* gamma_out)
{
    Impl& M = *m_impl;
    PbcState& I = M.pbc;
    if (!ok() || !M.ensurePbcBlas() || nat <= 0 || nsh <= 0 || nk < 0 || nko <= 0 || !xyz_bohr || !cell_L || !sh2at
        || !hardness || !ko_trans || !gamma_out || (nk > 0 && !ktab) || !(alpha > 0.0) || !(volume > 0.0))
        return false;
    const size_t n2 = static_cast<size_t>(nat) * nat, s2 = static_cast<size_t>(nsh) * nsh;
    if (n2 > static_cast<size_t>(INT_MAX) || s2 > static_cast<size_t>(INT_MAX)) return false;
    // k block: the phase matrix M (nat x 2 nb) stays below 128 MB
    const int nb_max = std::max(1, std::min(std::max(nk, 1), static_cast<int>((16u << 20) / (2u * static_cast<unsigned>(nat)))));
    hipStream_t stream = M.stream;
    bool okk = true, gamma_kept = false;
    I.gamma_pbc_resident = false;
    try {
        I.dPbcXyz.upload(xyz_bohr, 3 * nat, stream);
        if (nk > 0) I.dPbcKtab.upload(ktab, 4 * nk, stream);
        I.dPbcKoTrans.upload(ko_trans, 3 * nko, stream);
        I.dPbcShAt.upload(sh2at, nsh, stream);
        I.dPbcShG.upload(hardness, nsh, stream);
        I.dPbcEwA.ensure(static_cast<int>(n2));
        I.dPbcGamma.ensure(static_cast<int>(s2));
        if (nk > 0) I.dPbcEwM.ensure(2 * nb_max * nat);
        if (hipMemsetAsync(I.dPbcEwA.ptr, 0, n2 * sizeof(double), stream) != hipSuccess) okk = false;
        const double one = 1.0;
        for (int k0 = 0; okk && k0 < nk; k0 += nb_max) {
            const int nb = std::min(nb_max, nk - k0);
            const long long nt = static_cast<long long>(nat) * nb;
            pbc_dev::k_ewald_phase<<<static_cast<unsigned>((nt + 255) / 256), 256, 0, stream>>>(nat, nb, I.dPbcKtab.ptr + 4 * k0,
                                                                                      I.dPbcXyz.ptr, I.dPbcEwM.ptr);
            if (hipGetLastError() != hipSuccess) { okk = false; break; }
            if (rocblas_dsyrk(M.handle, rocblas_fill_lower, rocblas_operation_none, nat, 2 * nb, &one, I.dPbcEwM.ptr, nat, &one,
                            I.dPbcEwA.ptr, nat) != rocblas_status_success) { okk = false; break; }
        }
        if (okk) {
            const double cself = 2.0 * alpha / sqrt(M_PI);
            const double cbg = M_PI / (alpha * alpha * volume);
            const dim3 blk(16, 16);
            pbc_dev::k_ewald_finish<<<dim3((nat + 15) / 16, (nat + 15) / 16), blk, 0, stream>>>(
                nat, I.dPbcXyz.ptr, cell_L[0], cell_L[1], cell_L[2], alpha, r_cut * r_cut, cself, cbg, I.dPbcEwA.ptr);
            if (hipGetLastError() != hipSuccess) okk = false;
            if (okk) {
                pbc_dev::k_gamma_pbc<<<dim3((nsh + 15) / 16, (nsh + 15) / 16), blk, 0, stream>>>(
                    nsh, nat, I.dPbcShAt.ptr, I.dPbcShG.ptr, harmonic ? 1 : 0, gexp, I.dPbcEwA.ptr, I.dPbcXyz.ptr,
                    cell_L[0], cell_L[1], cell_L[2], nko, I.dPbcKoTrans.ptr, ko_cut, I.dPbcGamma.ptr);
                if (hipGetLastError() != hipSuccess) okk = false;
            }
            if (okk && hipMemcpyAsync(gamma_out, I.dPbcGamma.ptr, s2 * sizeof(double), hipMemcpyDeviceToHost,
                                       stream) != hipSuccess)
                okk = false;
            // ROCm A3: the resident copy of CUDA R2 (dGamma for beginPotentialPeriodic / the R5 GFN1 loop) is not
            // ported, so periodicGammaResident() stays false and the periodic SCF keeps the host-driven loop.
        }
    } catch (...) {
        okk = false;
    }
    okk = (hipStreamSynchronize(stream) == hipSuccess) && okk;
    I.gamma_pbc_resident = okk && gamma_kept;
    I.dPbcEwM.free();
    I.dPbcEwA.free();
    I.dPbcGamma.free();
    return okk;
}

// Claude Generated (Nov 2026, WP-PERIODIC-XTB G5d): periodic repulsion (kernels k_rep_pbc, k_rep_rows).
bool XtbHipContext::repulsionPeriodic(int nat, const double* xyz_bohr, const double* alpha, const double* zeff,
                                      const int* light, double kexp, double kexp_light, double rexp,
                                      const double* cell_L, int ntrans, const double* trans, double cut2,
                                      bool gradient, bool want_virial, double* energy_out, double* grad_out,
                                      double* vir9_out)
{
    Impl& M = *m_impl;
    PbcState& I = M.pbc;
    if (!ok() || nat <= 0 || ntrans <= 0 || !xyz_bohr || !alpha || !zeff || !light || !cell_L || !trans
        || (!gradient && !energy_out) || (gradient && !grad_out) || (gradient && want_virial && !vir9_out))
        return false;
    const size_t nn = static_cast<size_t>(nat) * nat;
    if (nn > static_cast<size_t>(INT_MAX)) return false;
    hipStream_t stream = M.stream;
    const dim3 blk(16, 16);   // 256 threads: the block tree of the virial assumes a power of two
    const dim3 grd((nat + 15) / 16, (nat + 15) / 16);
    bool okk = true;
    std::vector<double> erow;
    try {
        I.dPbcXyz.upload(xyz_bohr, 3 * nat, stream);
        I.dPbcRepAlp.upload(alpha, nat, stream);
        I.dPbcRepZeff.upload(zeff, nat, stream);
        I.dPbcRepLight.upload(light, nat, stream);
        I.dPbcRepTrans.upload(trans, 3 * ntrans, stream);
        if (!gradient) {
            I.dPbcRepE.ensure(static_cast<int>(nn) + nat);
            double* ep = I.dPbcRepE.ptr;
            pbc_dev::k_rep_pbc<false, false><<<grd, blk, 0, stream>>>(nat, I.dPbcXyz.ptr, I.dPbcRepAlp.ptr, I.dPbcRepZeff.ptr,
                I.dPbcRepLight.ptr, kexp, kexp_light, rexp, cell_L[0], cell_L[1], cell_L[2], ntrans, I.dPbcRepTrans.ptr,
                cut2, ep, nullptr, nullptr);
            if (hipGetLastError() != hipSuccess) okk = false;
            if (okk) {
                pbc_dev::k_rep_rows<<<(nat + 127) / 128, 128, 0, stream>>>(nat, ep, ep + nn);
                if (hipGetLastError() != hipSuccess) okk = false;
            }
            erow.resize(nat);
            if (okk && hipMemcpyAsync(erow.data(), ep + nn, sizeof(double) * nat, hipMemcpyDeviceToHost, stream)
                           != hipSuccess)
                okk = false;
        } else {
            I.dPbcRepFix.ensure(3 * nat + 9);
            if (hipMemsetAsync(I.dPbcRepFix.ptr, 0, sizeof(double) * (3 * nat + 9), stream) != hipSuccess) okk = false;
            double* gfix = I.dPbcRepFix.ptr;
            double* vfix = gfix + 3 * nat;
            if (okk) {
                if (want_virial)
                    pbc_dev::k_rep_pbc<true, true><<<grd, blk, 0, stream>>>(nat, I.dPbcXyz.ptr, I.dPbcRepAlp.ptr,
                        I.dPbcRepZeff.ptr, I.dPbcRepLight.ptr, kexp, kexp_light, rexp, cell_L[0], cell_L[1], cell_L[2],
                        ntrans, I.dPbcRepTrans.ptr, cut2, nullptr, gfix, vfix);
                else
                    pbc_dev::k_rep_pbc<true, false><<<grd, blk, 0, stream>>>(nat, I.dPbcXyz.ptr, I.dPbcRepAlp.ptr,
                        I.dPbcRepZeff.ptr, I.dPbcRepLight.ptr, kexp, kexp_light, rexp, cell_L[0], cell_L[1], cell_L[2],
                        ntrans, I.dPbcRepTrans.ptr, cut2, nullptr, gfix, vfix);
                if (hipGetLastError() != hipSuccess) okk = false;
            }
            const int nfix = 3 * nat + 9;
            if (okk) {
                pbc_dev::k_pfix_to_double<<<(nfix + 255) / 256, 256, 0, stream>>>(nfix, gfix);
                if (hipGetLastError() != hipSuccess) okk = false;
            }
            if (okk && hipMemcpyAsync(grad_out, gfix, sizeof(double) * 3 * nat, hipMemcpyDeviceToHost, stream)
                           != hipSuccess)
                okk = false;
            if (okk && want_virial
                && hipMemcpyAsync(vir9_out, vfix, sizeof(double) * 9, hipMemcpyDeviceToHost, stream) != hipSuccess)
                okk = false;
        }
    } catch (...) {
        okk = false;
    }
    okk = (hipStreamSynchronize(stream) == hipSuccess) && okk;
    I.dPbcRepE.free();
    if (!okk) return false;
    if (gradient) {
        int fix_bad = 0;   // a non-finite or out-of-range contribution: fail (the host loop runs), reset the flag
        if (hipMemcpyFromSymbol(&fix_bad, HIP_SYMBOL(pbc_dev::g_pfix_bad), sizeof(int)) != hipSuccess) return false;
        if (fix_bad) {
            const int zero = 0;
            (void)hipMemcpyToSymbol(HIP_SYMBOL(pbc_dev::g_pfix_bad), &zero, sizeof(int));
            return false;
        }
    } else {
        double e = 0.0;
        for (int i = 0; i < nat; ++i) e += erow[i];   // fixed atom order
        *energy_out = e;
    }
    return true;
}

// Claude Generated (Nov 2026, WP-PERIODIC-XTB G5c): periodic CN chain rule (kernel k_cnchain_pbc).
bool XtbHipContext::cnChainGradientPeriodic(int nat, const double* xyz_bohr, const double* rcov, const double* dEdcn,
