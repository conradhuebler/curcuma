+        auto* pool = threadPool();
+        m_workspace->forEachD4PairList([&](std::vector<GFNFFDispersion>& d4_pairs) {
+            if (!weights_fresh) {
+                if (pool) pool->setActiveThreadCount(m_threads);
+                std::vector<double> cn_std(m_last_cn.data(), m_last_cn.data() + m_atomcount);
